---
interface Props {
  version?: string;
}
const { version = "LOCAL" } = Astro.props;
---

<figure class="device-plate">
  <svg
    viewBox="0 0 560 560"
    role="img"
    aria-labelledby="plate-title plate-desc"
  >
    <title id="plate-title">Stick-S3 presentation instrument</title>
    <desc id="plate-desc"
      >Technical illustration of the Stick-S3, with its screen, application
      buttons, and USB-C connection.</desc
    >
    <defs>
      <pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse"
        ><circle cx="1" cy="1" r=".7" fill="#EFEBE0" opacity=".18"
        ></circle></pattern
      >
      <pattern
        id="hatch"
        width="5"
        height="5"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)"
        ><line x1="0" y1="0" x2="0" y2="5" stroke="#EFEBE0" stroke-width="1"
        ></line></pattern
      >
    </defs>
    <rect width="560" height="560" fill="#17160F"></rect>
    <rect
      x="18"
      y="18"
      width="524"
      height="524"
      fill="none"
      stroke="#EFEBE0"
      stroke-width="1"></rect>
    <g stroke="#EFEBE0" fill="none" stroke-width="1"
      ><path
        d="M29 34h10m-5-5v10M521 34h10m-5-5v10M29 526h10m-5-5v10M521 526h10m-5-5v10"
      ></path></g
    >
    <g
      font-family="ui-monospace,monospace"
      fill="#EFEBE0"
      font-size="9"
      letter-spacing="1.5"
      ><text x="48" y="55">N° 0001</text><text
        x="280"
        y="55"
        text-anchor="middle">STICK–S3 / SERIES S</text
      ><text x="512" y="55" text-anchor="end">FIG.01</text></g
    >
    <path
      d="M48 68H512M350 68V448M48 448H512"
      stroke="#EFEBE0"
      stroke-width=".7"
      fill="none"></path>
    <rect x="49" y="86" width="283" height="343" fill="url(#dots)"></rect>
    <circle
      cx="196"
      cy="255"
      r="126"
      stroke="#EFEBE0"
      stroke-opacity=".35"
      fill="none"
      stroke-dasharray="2 6"></circle>
    <path
      d="M57 255H337M196 92V420"
      stroke="#EFEBE0"
      stroke-opacity=".25"
      stroke-dasharray="3 5"></path>
    <g transform="rotate(-13 196 253)">
      <rect
        x="129"
        y="112"
        width="137"
        height="278"
        rx="24"
        fill="#2438E8"
        stroke="#EFEBE0"
        stroke-width="1.7"></rect>
      <rect
        x="135"
        y="118"
        width="125"
        height="266"
        rx="19"
        fill="none"
        stroke="#EFEBE0"
        stroke-opacity=".35"></rect>
      <rect
        x="141"
        y="147"
        width="113"
        height="155"
        rx="5"
        fill="#141310"
        stroke="#EFEBE0"
        stroke-width="1.2"></rect>
      <path d="M150 172h94" stroke="#EFEBE0" stroke-opacity=".35"></path>
      <g fill="#EFEBE0" font-family="ui-monospace,monospace"
        ><text x="151" y="164" font-size="7" letter-spacing="1"
          >DECK CLICKER</text
        ><text x="152" y="204" font-size="17" letter-spacing="2">READY</text
        ><text x="152" y="223" font-size="6.5" letter-spacing="1"
          >BLE / CONNECTED</text
        ><text x="152" y="267" font-size="7">A → NEXT</text><text
          x="152"
          y="283"
          font-size="7">B ← BACK</text
        ></g
      >
      <circle cx="242" cy="134" r="2" fill="#EFEBE0"></circle><path
        d="M152 134h25"
        stroke="#EFEBE0"
        stroke-width="2"></path>
      <rect
        x="165"
        y="321"
        width="65"
        height="43"
        rx="13"
        fill="#17160F"
        stroke="#EFEBE0"
        stroke-width="1.2"></rect>
      <circle
        cx="197"
        cy="342"
        r="8"
        fill="none"
        stroke="#EFEBE0"
        stroke-width="1"></circle><path d="M197 337v10m-5-5h10" stroke="#EFEBE0"
      ></path>
      <rect x="266" y="204" width="5" height="29" rx="2" fill="#EFEBE0"></rect>
      <rect
        x="182"
        y="386"
        width="30"
        height="6"
        rx="3"
        fill="#141310"
        stroke="#EFEBE0"></rect>
    </g>
    <g
      fill="#EFEBE0"
      font-family="ui-monospace,monospace"
      font-size="8"
      letter-spacing="1"
      ><text x="374" y="101">INSTRUMENT / 01</text><text
        x="374"
        y="137"
        font-size="20"
        letter-spacing="2">S3</text
      ><text x="374" y="155">WIRELESS CONTROL</text><text x="374" y="221"
        >USB–C</text
      ><text x="374" y="237" opacity=".6">FLASH INTERFACE</text><text
        x="374"
        y="293">BLUETOOTH</text
      ><text x="374" y="309" opacity=".6">KEYBOARD / HID</text><text
        x="374"
        y="365">ESP32–S3</text
      ><text x="374" y="381" opacity=".6">M5STACK</text><text
        x="196"
        y="426"
        text-anchor="middle">TYPE / DECK CONTROLLER</text
      ></g
    >
    <path
      d="M374 175h115M374 251h115M374 325h115M374 397h115"
      stroke="#EFEBE0"
      stroke-width=".6"></path>
    <rect x="374" y="185" width="115" height="8" fill="#2438E8"></rect>
    <g fill="#EFEBE0"
      ><rect x="374" y="413" width="2" height="16"></rect><rect
        x="379"
        y="413"
        width="4"
        height="16"></rect><rect x="386" y="413" width="1" height="16"
      ></rect><rect x="391" y="413" width="3" height="16"></rect><rect
        x="398"
        y="413"
        width="5"
        height="16"></rect><rect x="407" y="413" width="2" height="16"
      ></rect><rect x="414" y="413" width="4" height="16"></rect><rect
        x="421"
        y="413"
        width="1"
        height="16"></rect><rect x="426" y="413" width="3" height="16"
      ></rect><rect x="433" y="413" width="5" height="16"></rect><rect
        x="443"
        y="413"
        width="2"
        height="16"></rect></g
    >
    <text
      x="48"
      y="487"
      fill="#EFEBE0"
      font-family="ui-monospace,monospace"
      font-size="28"
      letter-spacing="3">DECK—01</text
    ><text
      x="48"
      y="514"
      fill="#EFEBE0"
      font-family="ui-monospace,monospace"
      font-size="8"
      letter-spacing="1.2">SYS.03 / PRESENT / CONTROL / REPEAT</text
    ><rect x="496" y="468" width="16" height="16" fill="#2438E8"></rect>
  </svg>
  <figcaption>
    <span>01 / INSTRUMENT ILLUSTRATION</span><span>{version}</span>
  </figcaption>
</figure>

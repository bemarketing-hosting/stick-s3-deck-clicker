---
import { product } from "../product";
import "../styles/theme.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={product.description} />
    <meta name="theme-color" content="#141310" />
    <title>{product.title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
  </head>
  <body>
    <a class="skip-link" href="#install">Skip to installer</a>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="brand"
          href={import.meta.env.BASE_URL}
          aria-label={`${product.name} ${product.descriptor} home`}
          ><span class="brand-mark" aria-hidden="true">✳</span> {product.name.toUpperCase()} <span
            class="brand-divider">/</span
          > {product.descriptor.toUpperCase()}</a
        >
        <div class="header-meta">
          <span class="status-dot" aria-hidden="true"></span> OPEN HARDWARE. CLEAR
          SIGNAL.
        </div>
        <a class="text-link" href={product.repository}>SOURCE ↗</a>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>{product.name.toUpperCase()} / PRESENTATION INSTRUMENT</span><span
          >BUILT FOR THE NEXT SLIDE.</span
        ><a href={product.repository}>FIRMWARE + SOURCE ↗</a>
      </footer>
    </div>
  </body>
</html>
